<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
          "-//Puppy Crawl//DTD Check Configuration 1.3//EN"
          "http://checkstyle.sourceforge.net/dtds/configuration_1_3.dtd">

<!--
  Checkstyle configuration for GD-BASIC. It checks the rules of prompts/STYLEGUIDE.md.

  Rules that the STYLEGUIDE does not mention are commented out with the note "not in STYLEGUIDE". They can be
  switched on again by removing the comment markers, after the maintainers decide on them.

  Name patterns used below:
    member, static member, local variable, parameter:  optional a/m/v, then str/e/i/l/b/f/o/c, then a name
    constant:                                           UPPER_SNAKE_CASE, or a member pattern with the _ prefix
    catch parameter:                                    o followed by a name (oException)
-->

<!--suppress ALL -->
<module name="Checker">
    <property name="severity" value="warning"/>
    <property name="fileExtensions" value="java, properties, xml"/>

    <!-- STYLEGUIDE: maximum 160 characters per line. -->
    <module name="LineLength">
        <property name="max" value="160"/>
    </module>

    <!-- Files: spaces, not tabs; newline at the end of the file. -->
    <module name="FileTabCharacter"/>
    <module name="NewlineAtEndOfFile"/>
    <module name="FileLength"/>

    <!-- <module name="JavadocPackage"/> not in STYLEGUIDE -->

    <module name="TreeWalker">

        <!-- STYLEGUIDE "Naming Conventions", "Fields and Variables", "Constants". -->
        <module name="ConstantName">
            <property name="format"
                      value="^([A-Z][A-Z0-9]*(_[A-Z0-9]+)*|_(a|m|v)?(str|[eilbofc])[A-Z][A-Za-z0-9]*)$"/>
        </module>
        <module name="LocalFinalVariableName">
            <property name="format" value="^(a|m|v)?(str|[eilbofc])[A-Z][A-Za-z0-9]*$"/>
        </module>
        <module name="LocalVariableName">
            <property name="format" value="^(a|m|v)?(str|[eilbofc])[A-Z][A-Za-z0-9]*$"/>
        </module>
        <module name="MemberName">
            <property name="format" value="^_(a|m|v)?(str|[eilbofc])[A-Z][A-Za-z0-9]*$"/>
        </module>
        <module name="StaticVariableName">
            <property name="format" value="^_(a|m|v)?(str|[eilbofc])[A-Z][A-Za-z0-9]*$"/>
        </module>
        <module name="ParameterName">
            <property name="format" value="^(a|m|v)?(str|[eilbofc])[A-Z][A-Za-z0-9]*$"/>
        </module>
        <module name="CatchParameterName">
            <property name="format" value="^o[A-Z][A-Za-z0-9]*$"/>
        </module>
        <!-- STYLEGUIDE: methods use lowerCamelCase (no underscore prefix). -->
        <module name="MethodName"/>
        <!-- STYLEGUIDE "Packages": lowercase letters only, no separators. -->
        <module name="PackageName">
            <property name="format" value="^[a-z][a-z0-9]*(\.[a-z][a-z0-9]*)*$"/>
        </module>
        <module name="TypeName"/>

        <!-- STYLEGUIDE "Field and Variable Declarations": one variable per line. -->
        <module name="MultipleVariableDeclarations"/>

        <!-- STYLEGUIDE "Annotations": annotations on the line before the method or class. -->
        <module name="AnnotationLocation"/>

        <!-- STYLEGUIDE "Access Level Modifiers" and "Getters and Setters": no public or protected fields. -->
        <module name="VisibilityModifier"/>

        <!-- STYLEGUIDE "Method Length": aim for methods under 50 lines. -->
        <module name="MethodLength">
            <property name="max" value="50"/>
        </module>

        <!-- Imports: STYLEGUIDE does not list them, but unused and wildcard imports are not allowed in this project. -->
        <module name="AvoidStarImport"/>
        <module name="IllegalImport"/>
        <module name="RedundantImport"/>
        <module name="UnusedImports">
            <property name="processJavadoc" value="false"/>
        </module>

        <!-- STYLEGUIDE "Indentation", "Brace Style": 4 spaces, braces on the same line, always braces. -->
        <module name="LeftCurly"/>
        <module name="RightCurly"/>
        <module name="NeedBraces"/>
        <module name="AvoidNestedBlocks"/>
        <module name="EmptyBlock"/>

        <!-- STYLEGUIDE "Switch Statements": always a default case. -->
        <module name="MissingSwitchDefault"/>

        <!-- STYLEGUIDE "Modifier" and whitespace: keep the Java layout consistent. -->
        <module name="ModifierOrder"/>
        <module name="RedundantModifier"/>
        <module name="ArrayTypeStyle"/>
        <module name="UpperEll"/>
        <module name="EmptyForIteratorPad"/>
        <module name="GenericWhitespace"/>
        <module name="MethodParamPad"/>
        <module name="NoWhitespaceAfter"/>
        <module name="NoWhitespaceBefore">
            <property name="allowLineBreaks" value="true"/>
        </module>
        <module name="OperatorWrap"/>
        <module name="ParenPad"/>
        <module name="TypecastParenPad"/>
        <module name="WhitespaceAfter"/>
        <module name="WhitespaceAround"/>

        <!-- Correctness checks (not named in the STYLEGUIDE, but they find real errors). -->
        <module name="EmptyStatement"/>
        <module name="EqualsHashCode"/>
        <module name="IllegalInstantiation"/>
        <module name="InnerAssignment"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="InterfaceIsType"/>

        <!-- STYLEGUIDE "Comments": TODO markers are used to tag code that is marked for later work. -->
        <!-- <module name="TodoComment"/> --> <!-- TODO tags are allowed; see the TODO rule in the style guide -->

        <!-- Not in STYLEGUIDE (commented out, to be decided by the maintainers) -->
        <!-- <module name="JavadocMethod"/> -->
        <!-- <module name="JavadocType"/> -->
        <!-- <module name="JavadocStyle"/> -->
        <!-- <module name="JavadocVariable"/> -->
        <!-- <module name="ParameterNumber"/> not in STYLEGUIDE -->
        <!-- <module name="AvoidInlineConditionals"/> not in STYLEGUIDE -->
        <!-- <module name="HiddenField"/> not in STYLEGUIDE: setters use this.field = field -->
        <!-- <module name="DesignForExtension"/> not in STYLEGUIDE -->
        <!-- <module name="FinalClass"/> not in STYLEGUIDE -->
        <!-- <module name="HideUtilityClassConstructor"/> not in STYLEGUIDE -->
        <!-- <module name="FinalParameters"/> not in STYLEGUIDE -->
        <!-- <module name="MagicNumber"/> not in STYLEGUIDE -->
        <!-- <module name="SuppressWarningsHolder"/> not in STYLEGUIDE -->

    </module>
    <module name="SuppressWarningsFilter"/>

</module>
