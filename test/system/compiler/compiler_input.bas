1 REM ========================================================================
2 REM Compiler test: INPUT
3 REM Description: Reads a text and a number from standard input (see compiler_input.in).
4 REM              The compiled program must print exactly what the interpreter prints.
5 REM ========================================================================
10 INPUT N$
20 PRINT "Hello "; N$
30 INPUT A
40 PRINT -A
50 PRINT A * 2
60 END
