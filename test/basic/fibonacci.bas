10 REM FIBONACCI SEQUENCE PROJECT
20 REM CONVERTED FOR GD-BASIC INTERPRETER
30 REM THE ARRAY F HOLDS THE FIBONACCI NUMBERS
40 DIM F# (50)
50 LET F# (0) = 0
60 LET F# (1) = 1
70 PRINT F# (0),
80 PRINT F# (1),
90 FOR N# = 1 TO 19
100 LET F# (N#+1) = F# (N#) + F# (N#-1)
110 PRINT F# (N#+1),
120 NEXT
130 PRINT
999 END