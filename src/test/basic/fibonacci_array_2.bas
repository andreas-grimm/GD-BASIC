10 REM FIBONACCI SEQUENCE PROJECT
20 REM USING ARRAYS AS IN ORIGINAL PROGRAM
30 REM THE ARRAY F HOLDS THE FIBONACCI NUMBERS
40 F%(0) = 0
50 F%(1) = 1
60 N% = 1
70 PRINT F%(0)
80 REM COMPUTE THE NEXT FIBONACCI NUMBER
90 NP1% = N% + 1
100 NM1% = N% - 1
110 F%(N% + 1) = F%(N%) + F%(NM1%)
120 N% = N% + 1
130 PRINT F%(N%)
140 REM STOP AFTER PRINTING 20 NUMBERS
150 IF N% < 20 THEN 80
160 PRINT
999 END